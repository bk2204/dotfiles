def uri_encode(s)
  s.b.gsub(/[^A-Za-z0-9._~-]/) { |m| "%%%02x" % m.ord }
end

DCTJump.configure do |c|
  c.editor = ->(foreground: false) do
    command = ['zsh', '-c', "bmc_editor \"$@\"", "bmc_editor"]
    command += (foreground ? %w[--detach] : [])
    data = ''
    IO.popen(c.env, command, 'r') do |io|
      data = io.read
    end
    data
  end

  c.on('hello') do
    puts "Hello, world!"
  end

  c.on('hello', /(.+)/) do |m|
    puts "Hello, #{m[0][1]}!"
  end

  c.on(/\A(es|fr|de)\z/, /(.+)/) do |m|
    c.open("https://www.wordreference.com/#{m[0][1]}en/#{uri_encode(m[1][1])}")
  end

  c.on(/\A(esfr|fres)\z/, /(.+)/) do |m|
    c.open("https://www.wordreference.com/fres/#{uri_encode(m[1][1])}")
  end

  c.on('notes', /(.+)/) do |m|
    c.edit("+Notes #{m[0][1]}")
  end

  c.data[:repos] = {
    'lfs' => 'git-lfs/git-lfs',
    'git' => 'git/git',
  }

  repos_re = Regexp.new("(#{c.data[:repos].keys.join('|')})")

  c.on(/\A#{repos_re}\z/, /\A([ipd])?(\d+)?\z/) do |m|
    suffix = if m[1]
               case m[1][1]
               when 'i', nil
                 "issues/#{m[1][2]}"
               when 'p'
                 "pull/#{m[1][2]}"
               when 'd'
                 "discussions/#{m[1][2]}"
               end
             else
               ''
             end
    c.open("https://github.com/#{c.data[:repos][m[0][1]]}/#{suffix}")
  end

  c.on('repos') do
    repos.each do |(name, repo)|
      $stdout.puts "#{name}\t#{repo}"
    end
  end
end

