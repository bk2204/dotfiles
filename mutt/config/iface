# Interface.
set beep=yes
set beep_new=no
set charset=utf-8
set duplicate_threads=yes
set include=yes
set quit=ask-no
set index_format="%4C %Z %[%b %d] %-15.15F (%4c) %s"
set recall=no
set sort=threads
set sort_aux=date
set sort_thread_groups=last-date-received
set wait_key=no

color normal white black
color attachment brightyellow black
color hdrdefault cyan black
color indicator black cyan
color markers brightred black
color quoted brightgreen black
color signature cyan black
color status brightgreen blue
color tilde blue black
color tree red black

color index brightred black ~D
color index brightcyan black ~T

color header cyan black ^
color status bold cyan black
# vim: set syntax=muttrc:
