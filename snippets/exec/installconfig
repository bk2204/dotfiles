#!/usr/bin/env ruby

require 'optparse'
require 'yaml'

class DesktopConfigProcessor
  class BadExitStatus < StandardError; end

  class BaseDesktopConfigProcessor
    attr_reader :config, :options

    def process
      config[top_section].each do |(cfg, cfgdata)|
        cfgdata[entry_section].each do |(group, groupdata)|
          if groupdata.is_a?(Hash)
            groupdata.each do |(key, value)|
              process_config(options, cfg, [group], key, value)
            end
          else
            process_config(options, cfg, [], group, groupdata)
          end
        end
      end
    end

    def process_config(options, cfg, groups, key, value)
      if value.is_a?(Hash)
        groups = groups.dup
        groups << key
        value.each do |(key, val)|
          process_config(options, cfg, groups, key, val)
        end
      else
        run_command(format_args(cfg, groups, key, value))
      end
    end

    protected

    def run_command(args)
      $stderr.puts "Running #{command} #{args.join(" ")}" if options[:verbose]
      unless options[:dry_run]
        spawn(options[:env], command, *args)
        Process.wait
        raise BadExitStatus, $? unless $?.success?
      end
    end
  end

  class KDEDesktopConfigProcessor < BaseDesktopConfigProcessor
    def initialize(config, options)
      @config = config
      @options = options
    end

    def top_section
      'files'
    end

    def entry_section
      'groups'
    end

    def command
      'kwriteconfig6'
    end

    def format_args(cfg, groups, key, value)
      file = File.join(options[:base], cfg)
      args = ["--file", file]
      args += groups.flat_map { |g| ["--group", g] }
      args += ["--key", key.to_s]
      case value
      when true, false
        args += ["--type=bool", value.to_s]
      when nil
        args += ["--delete"]
      else
        args += [value.to_s]
      end
    end
  end

  class MacOSDesktopConfigProcessor < BaseDesktopConfigProcessor
    def initialize(config, options)
      @config = config
      @options = options
    end

    def top_section
      'domains'
    end

    def entry_section
      'keys'
    end

    def command
      'defaults'
    end

    def format_args(cfg, groups, key, value)
      args = [cfg, key.to_s]
      subcommand = 'write'
      case value
      when true, false
        args += ["-bool", value.to_s.upcase]
      when nil
        subcommand = 'delete'
      when Integer
        args += ["-int", value.to_s]
      else
        args += [value.to_s]
      end
      [subcommand] + args
    end
  end

  def initialize(stdin, stdout, stderr)
    @stdin = stdin
    @stdout = stdout
    @stderr = stderr
  end

  def process_file(options, file)
    data = YAML.safe_load(File.read(file))
    p = case options[:desktop]
        when :kde
          KDEDesktopConfigProcessor.new(data, options)
        when :macos
          MacOSDesktopConfigProcessor.new(data, options)
        end
    p.process
  end

  def run(env, args)
    env = env.to_h
    base = env["XDG_CONFIG_HOME"] || File.join(env["HOME"], ".config")
    options = {files: [], base: base, env: env, desktop: :kde}
    OptionParser.new do |opts|
      opts.on("-f", "--file FILE", "process FILE") do |arg|
        options[:files] << arg
      end

      opts.on("-v", "--verbose", "be more verbose") do
        options[:verbose] = true
      end

      opts.on("-n", "--dry-run", "just print what would be done, don't do it") do
        options[:dry_run] = true
      end

      opts.on("-d DESKTOP", "--desktop DESKTOP", [:kde, :macos], "choose the given desktop") do |desktop|
        options[:desktop] = desktop
      end
    end.order!(args)

    options[:files].each do |file|
      process_file(options, file)
    end
    0
  end
end

exit DesktopConfigProcessor.new($stdin, $stdout, $stderr).run(ENV, ARGV) if __FILE__ == $0
