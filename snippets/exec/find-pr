#!/bin/sh -e

OPTS_SPEC="\
find-pr [<options>] <revision> [<base>]

find-pr finds the pull request or merge request that introduced a commit and
prints the number to standard output.  The history traversed is that of the
specified base, or HEAD if not specified.
--
h,help!   show the help
jump!     jump to the PR based on the remote in the repository
print!    print the PR URL on the remote in the repository
"

eval "$(echo "$OPTS_SPEC" | git rev-parse --parseopt -- "$@" || echo exit $?)"

mode=print-num

while [ $# -gt 0 ]
do
    arg="$1"
    shift
    case "$arg" in
        --help)
            exit 0
            ;;
        --jump)
            mode=jump-url
            ;;
        --print)
            mode=print-url
            ;;
        --)
            break
            ;;
    esac
done

REV="$1"
HEAD="${2:-HEAD}"

NUM=$( (
  git log --ancestry-path --format='A %H %s' "$REV..$HEAD";
  git log --first-parent --format='F %H %s' "$REV..$HEAD";
) | \
  ruby -e '
  a = {}
  f = [];
  while gets
    if $_ =~ /^A ([0-9a-f]+) Merge pull request #(\d+)/
      a[$1] = $2.to_i
    end
    if $_ =~ /^F ([0-9a-f]+)/ && a[$1];
      f << $1
    end
  end
  if f.empty?
    exit 1
  else
    puts a[f.last]
  end
  ')

case "$mode" in
    print-num)
        echo "$NUM"
        ;;
    jump-url)
        dct-jump ghl p"$NUM"
        ;;
    print-url)
        dct-jump --print ghl p"$NUM"
        ;;
    *)
        exit 2
        ;;
esac
