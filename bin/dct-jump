require 'optparse'
require 'shellwords'

class DCTJump
  class << self
    def config
      @config ||= Configuration.new
    end

    def configure
      yield config
    end
  end

  class Rule
    def matches?(args)
      !!match
    end

    def run_on_match(args)
      m = match(args)
      if m.nil?
        false
      else
        @block.call(m, **@options)
        true
      end
    end
  end

  class SimpleRule < Rule
    def initialize(pat, block, **options)
      @pat = pat
      @block = block
      @options = options
    end

    protected

    def match(args)
      s = args.join(" ")
      pat = if @pat.is_a? String
              /\A#{Regexp.escape(@pat)}\z/
            else
              @pat
            end
      pat.match(s)
    end
  end

  class MultiRule < Rule
    def initialize(pats, block, **options)
      @pats = pats
      @block = block
      @options = options
    end

    protected

    def match(args)
      matches = []
      if args.length > @pats.length
        args = args[0..@pats.length-2] + [args[@pats.length-1..].join(" ")]
      end
      return nil if args.empty?
      args.zip(@pats).each do |arg, pat|
        return nil if arg.nil? || pat.nil?

        pat, insert = if pat.is_a? String
                        [/\A#{Regexp.escape(pat)}\z/, false]
                      else
                        [pat, true]
                      end
        m = pat.match(arg)
        return nil if m.nil?
        matches << m if insert
      end
      matches
    end
  end

  class Configuration
    attr_reader :rules
    attr_accessor :env, :data, :editor, :options

    def initialize
      @rules = []
      @env = ENV
      @data = {}
      @editor = nil
      @options = {output: :run}
    end

    def on(*args, simple: true, &block)
      if simple && args.length == 1
        @rules << SimpleRule.new(args[0], block)
      else
        @rules << MultiRule.new(args, block)
      end
      self
    end

    def do_command(env, cmd, *args)
      $stderr.puts Shellwords.join([cmd] + args) if @options[:verbose]
      system(env, cmd, *args)
    end

    def edit(*args, foreground: false)
      case options[:output]
      when :print
        $stdout.puts Shellwords.join(args)
      else
        editor = if @editor
                   @editor.call(foreground: foreground)
                 elsif @env['TERM'] && @env['TERM'] != 'dumb' && @env['VISUAL']
                   @env['VISUAL']
                 elsif @env['EDTIOR']
                   @env['EDITOR']
                 else
                   'vi'
                 end
        do_command(@env, 'sh', '-c', %Q[#{editor} "$@"], editor, *args)
      end
    end

    def open(*args)
      case options[:output]
      when :print
        $stdout.puts Shellwords.join(args)
      else
        commands = ['xdg-open', 'open']
        commands.each do |cmd|
          if which(cmd)
            do_command(env, cmd, *args)
            return
          end
        end
      end
    end

    def include(file, if_present: true)
      if File.exist?(file) || !if_present
        # This will raise an exception if the file is missing.
        load file
      end
    end

    private

    def which(cmd)
      env['PATH'].split(File::PATH_SEPARATOR).each do |path|
        exe = File.join(path, cmd)
        return exe if File.executable?(exe) && !File.directory?(exe)
      end
      nil
    end
  end

  def self.parse_args(args)
    options = {output: :run}
    OptionParser.new do |opts|
      opts.on('--help', 'Print this usage information') do
        puts opts

        $stdout.puts <<~EOM
        Usage: dct-jump [args]

        Evaluates the specified arguments using the configuration file and
        performs the action matching the given arguments.  Common actions include
        opening a URL in the browser or opening a file in an editor.
        EOM
        options[:command] = :help
      end

      opts.on('--print', 'Print URLs and files instead of running them') do
        options[:output] = :print
      end

      opts.on('-v', '--verbose', 'Print commands before running them') do
        options[:verbose] = :true
      end
    end.parse!(args)
    [options, args]
  end

  def self.main(args, env)
    options, args = parse_args(args)
    return 0 if options[:command] == :help

    config_path = env["XDG_CONFIG_HOME"] || File.join(env["HOME"], '.config')
    configure do |c|
      c.env = env
      c.options = options
      c.include(File.join(config_path, 'dct-jump', 'config'))
    end

    config.rules.each do |r|
      if r.run_on_match(args)
        return 0
      end
    end
    2
  end
end

exit DCTJump.main(ARGV, ENV) if $0 == __FILE__
