OPTS_SPEC="\
dct-mtree [<options>] <args>...

Process mtree-like files from these dotfiles to install files or generate
files which can be sent to mtree(1) for verification.

This script handles filenames with hash marks and spaces correctly, but not
other special characters.
--
h,help!     show this help

f,file=     source for mtree files
recurse     recurse into the working tree for mtree files
dry-run     print what would be installed instead of installing it
backend=    choose the backend to use (sh or ruby)

 Commands
mtree-src!  print a full mtree format file for the source directory
mtree-dest! print a full mtree format file for the destination directory
format!     format the default mtree format into per-line format
escape!     escape standard input suitably for mtree
unescape!   unescape standard input suitably for mtree
validate!   validate the input file
install!    install the input file
dump!       dump the internal Ruby script
"

main () {

    eval "$(echo "$OPTS_SPEC" | git rev-parse --parseopt -- "$@" || echo exit $?)"

    local cmd=""
    local file="-"
    local recurse="t"
    local dryrun=""
    local backend=""

    while test $# -gt 0
    do
        local opt="$1"
        shift
        case "$opt" in
            --mtree-src)
                cmd=mtree-src
                ;;
            --mtree-dest)
                cmd=mtree-dest
                ;;
            --validate)
                cmd=validate
                ;;
            --install)
                cmd=install
                ;;
            --dump)
                cmd=dump
                ;;
            --format)
                cmd=format
                ;;
            --escape)
                cmd=escape
                ;;
            --unescape)
                cmd=unescape
                ;;
            --file)
                file="$1"
                shift
                ;;
            --no-recurse)
                recurse=""
                ;;
            --dry-run)
                dryrun="t"
                ;;
            --backend)
                backend="$1"
                shift
                ;;
            --)
                break
                ;;
        esac
    done

    [ -z "$cmd" ] && { echo "Need a command." >&2; exit 2; }
    if [ -z "$backend" ]
    then
        backend="sh"
        command -v ruby >/dev/null 2>/dev/null && backend="ruby"
    fi
    if [ -z "$file" ] || [ "$file" = "-" ]
    then
        dispatch "$cmd" "$recurse" "$dryrun" "$backend" "$1"
    else
        cat "$file" | dispatch "$cmd" "$recurse" "$dryrun" "$backend" "$1"
    fi
}

extract_entry () {
    local args="$1"
    local entry="$2"
    echo "$args" | sed -ne 's/^\(.* \)\{0,\}'"$entry"'=\([^ ]*\).*$/\2/p'
}

do_escape () {
    local backend="$1"
    if command -v perl >/dev/null 2>&1 && [ "$backend" != sh ]
    then
        LC_ALL=C perl -pe 's/\\/\\134/g; s/#/\\#/g; s/ /\\s/g; s/\n/\\n/g; s/\t/\\t/g; s/([\x00-\x1f\x7f-\xff])/sprintf "\\%03o", ord($1)/ge;'
    else
        LC_ALL=C awk '
            function setup_escapes(c, i, e, rechars) {
                for (i = 1; i < 256; i++) {
                    if (i == 32) {
                        escapes[sprintf("%c", i)] = "\\s";
                    } else if (i == 9) {
                        escapes[sprintf("%c", i)] = "\\t";
                    } else if (i == 10) {
                        escapes[sprintf("%c", i)] = "\\n";
                    } else if (i == 35) {
                        escapes[sprintf("%c", i)] = "\\#";
                    } else if (i == 92) {
                        continue;
                    } else if (i < 32 || i > 126) {
                        escapes[sprintf("%c", i)] = sprintf("\\%03o", i);
                    }
                }
            }
            function convert(s) {
                gsub("\\\\", "\\134", s);
                for (i in escapes) {
                    gsub(i, escapes[i], s);
                }
                return s
            }
            BEGIN {
                setup_escapes();
            }
            { printf "%s", convert($0) }
        '
    fi
}

do_unescape () {
    local backend="$1"
    if command -v perl >/dev/null 2>&1 && [ "$backend" != sh ]
    then
        LC_ALL=C perl -pe '
            $x = {
                (map {
                    (sprintf("%03o", $_), chr($_))
                } 0..255),
                "\\" => "\\", "#" => "#", 0 => "\0",
                a => "\a", b => "\b", f => "\f", n => "\n", r => "\r", s => " ", t => "\t", v => "\x0b",
                "^?" => "\x7f", "M^@" => "\x80", "M^?" => "\xff",
                (map {
                    (
                        sprintf("^%c", 0x40 + $_) => chr($_),
                        sprintf("M^%c", 0x40 + $_) => chr(0x80 + $_),
                    )
                } 0x01..0x1f),
                (map {
                    (sprintf("M-%c", $_) => chr(0x80 + $_))
                } 0x21..0x7e),
            };
            s/\\(\^[A-_?]|M[-^][!-~]|[\\#abfnrstv]|[0-7]{3}|0(?![0-7]))/$x->{$1}/ge;
        '
    else
        LC_ALL=C awk '
            function setup_escapes(c, i, e, rechars) {
                for (i = 0; i < 256; i++) {
                    if (i == 92)
                        continue;
                    c = sprintf("\\\\%03o", i)
                    if (i == 38) {
                        escapes[c] = sprintf("\\%c", i)
                    } else {
                        escapes[c] = sprintf("%c", i)
                    }
                }
                rechars["["] = 1;
                rechars["]"] = 1;
                rechars["("] = 1;
                rechars[")"] = 1;
                rechars["|"] = 1;
                rechars["\\"] = 1;
                rechars["{"] = 1;
                rechars["}"] = 1;
                rechars["?"] = 1;
                rechars["+"] = 1;
                rechars["*"] = 1;
                rechars["^"] = 1;
                rechars["$"] = 1;
                rechars["."] = 1;
                for (i = 1; i < 32; i++) {
                    c = sprintf("%c", i + 64);
                    if (c == "\\")
                        continue;
                    if (rechars[c]) {
                        e = "\\"
                    } else {
                        e = ""
                    }
                    escapes[sprintf("\\\\\\^%s%c", e, 64 + i)] = sprintf("%c", i);
                    escapes[sprintf("\\\\M\\^%s%c", e, 64 + i)] = sprintf("%c", (128 + i));
                }
                for (i = 33; i < 127; i++) {
                    c = sprintf("%c", i)
                    if (rechars[c]) {
                        e = "\\"
                    } else {
                        e = ""
                    }
                    escapes[sprintf("\\\\M-%s%c", e, i)] = sprintf("%c", (128 + i))
                }
                escapes["\\\\a"] = "\a"
                escapes["\\\\b"] = "\b"
                escapes["\\\\f"] = "\f"
                escapes["\\\\n"] = "\n"
                escapes["\\\\r"] = "\r"
                escapes["\\\\s"] = " "
                escapes["\\\\t"] = "\t"
                escapes["\\\\v"] = "\v"
                escapes["\\\\\\^\\?"] = "\177"
                escapes["\\\\M\\^@"] = "\200"
                escapes["\\\\M\\^\\?"] = "\377"
            }
            function convert(s) {
                # This is ugly and technically incorrect. If we place \^\ next
                # to another escape sequence, such as \^], then we have \^\\^],
                # which gets parsed as a double backslash.  It is not possible
                # in the general case to do multi-pass parsing here when \ is
                # not solely an escape character and awk is incapable of doing
                # the required substitution for single-pass parse.
                gsub("\\\\\\^\\\\", "\\034", s);
                gsub("\\\\M\\^\\\\", "\\234", s);
                gsub("\\\\M-\\\\", "\\334", s);
                gsub("\\\\\\\\", "\\134", s);
                for (i in escapes) {
                    gsub(i, escapes[i], s);
                }
                gsub("\\\\0", "\000", s);
                gsub("\\\\134", "\\", s);
                return s
            }
            BEGIN {
                setup_escapes();
            }
            { printf "%s", convert($0) }
        '
    fi
}

escape () {
    local name="$1"
    local backend="$2"
    printf '%s' "$name" | do_escape "$backend"
}

unescape () {
    local name="$1"
    local backend="$2"
    printf '%s' "$name" | do_unescape "$backend"
}

prefix () {
    if [ -n "${1##./*}" ]
    then
        echo "./$1"
    else
        echo "$1"
    fi
}

format_line () {
    local kind="$1"
    local destdir="$2"
    local file="$3"
    local args="$4"

    local line src dest

    line=$(echo "$args" | tr ' ' '\n' | grep -E '^(type|mode|link|sha[0-9]+(digest)?|contents)=' | tr '\n' ' ' | sed -e 's/ *$//')
    dest="$file"
    case "$kind" in
        dest)
            src="$(extract_entry "$args" src)"
            src="${src:-$dest}"
            file="$(prefix "$file")"
            echo "$src"
            echo "$dest"
            echo "$file"
            echo "$file $line"
            ;;
        src)
            src="$(extract_entry "$args" src)"
            src="${src:-$dest}"
            file="$src"
            file="$(prefix "$file")"
            echo "$src"
            echo "$dest"
            echo "$file"
            echo "$file $line"
            ;;
        both)
            src="$(extract_entry "$args" src)"
            src="${src:-$dest}"
            if [ -n "$destdir" ]
            then
                dest="$destdir/$dest"
            else
                dest="$(prefix "${dest:-$file}")"
            fi
            file="$(prefix "$src")"
            echo "$src"
            echo "$dest"
            echo "$file"
            echo "$file $dest $line"
            ;;
    esac
}

find_dest () {
    local kind="$1"
    local src="$2"
    local destdir="$3"
    local root="$4"

    [ "$kind" = both ] || return
    echo "$root" | sed -e "s!^$src/!$destdir/!" -e 's/$/ /'
}

print_mtree () {
    local kind="$1"
    local do_recurse="$2"
    local destdir="$3"
    local src dest file args line recurse
    local filemode dirmode plainmode execmode
    local destval

    if [ -z "$destdir" ]
    then
        echo ". type=dir"
    else
        echo "$destdir type=dir"
    fi
    grep -vE '^(#|[	 ]*$)' | while read -r file args
    do
        data="$(format_line "$kind" "$destdir" "$file" "$args")"
        src="$(echo "$data" | sed -n 1p)"
        dest="$(echo "$data" | sed -n 2p)"
        file="$(echo "$data" | sed -n 3p)"
        echo "$data" | sed -n 4p
        recurse="$(extract_entry "$args" recurse)"
        if [ "$recurse" = true ] && [ "$do_recurse" = t ]
        then
            local destval
            dirmode="$(extract_entry "$args" dirmode)"
            filemode="$(extract_entry "$args" filemode)"
            if [ -z "${filemode%%*+x}" ]
            then
                plainmode="${filemode%%+x}"
                execmode="$(echo "$plainmode" | sed -e 's/6/7/' -e 's/4/5/')"
            else
                plainmode="$filemode"
                execmode="$filemode"
            fi
            src="$(prefix "$src")"
            find "$src" | sort | while read -r entry
            do
                if [ -d "$entry" ]
                then
                    [ "$entry" = "$src" ] && [ "$kind" != both ] && continue
                    entry="$(escape "$entry")"
                    destval=$(find_dest "$kind" "$src" "$dest" "$entry")
                    entry=$(echo "$entry" | sed -e "s!^$src/!$file/!")
                    echo "$entry ${destval}type=dir mode=$dirmode"
                elif [ -f "$entry" ]
                then
                    if [ -x "$entry" ]
                    then
                        mode="$execmode"
                    else
                        mode="$plainmode"
                    fi
                    entry="$(escape "$entry")"
                    destval=$(find_dest "$kind" "$src" "$dest" "$entry")
                    entry=$(echo "$entry" | sed -e "s!^$src/!$file/!")
                    echo "$entry ${destval}type=file mode=$mode"
                elif [ -h "$entry" ]
                then
                    linkdest=$(readlink "$entry")
                    entry="$(escape "$entry")"
                    destval=$(find_dest "$kind" "$src" "$dest" "$entry")
                    entry=$(echo "$entry" | sed -e "s!^$src/!$file/!")
                    echo "$entry ${destval}type=link mode=0777 link=$(escape "$linkdest")"
                fi
            done
        fi
    done
}

do_install () {
    local recurse="$1"
    local dryrun="$2"
    local dest="$3"

    print_mtree both "$recurse" "$dest" | tail -n+2 | (while read -r src dest args
    do
        local src="$(unescape "$src")"
        local dest="$(unescape "$dest")"
        local kind="$(extract_entry "$args" type)"
        local mode="$(extract_entry "$args" mode)"
        local link="$(extract_entry "$args" link)"
        local contents="$(extract_entry "$args" contents)"
        case "$kind" in
            dir)
                if [ -n "$dryrun" ]
                then
                    echo "Would create directory '$dest' with mode $mode"
                elif [ -n "$mode" ]
                then
                    mkdir -m "$mode" -p "$dest"
                    chmod "$mode" "$dest"
                else
                    mkdir -p "$dest"
                fi
                ;;
            file)
                if [ -n "$dryrun" ]
                then
                    echo "Would create file '$dest' from '$src' with mode $mode"
                else
                    if [ "$contents" = ignore ]
                    then
                        touch "$dest"
                    else
                        cp "$src" "$dest"
                    fi
                    chmod "$mode" "$dest"
                fi
                ;;
            link)
                if [ -n "$dryrun" ]
                then
                    echo "Would create link '$dest' pointing to '$link'"
                else
                    ln -sf "$link" "$dest"
                fi
                ;;
        esac
    done)
}

RUBY_SCRIPT='
module MTree
    def self.unescape(s)
        escapes = {
            "\\\\" => "\\",
            "\\#" => "#",
            "\\0" => "\0",
            "\\a" => "\a",
            "\\b" => "\b",
            "\\f" => "\f",
            "\\n" => "\n",
            "\\r" => "\r",
            "\\s" => " ",
            "\\t" => "\t",
            "\\v" => "\v",
            "\\^?" => "\x7f",
            "\\M^@" => "\x80",
            "\\M^?" => "\xff",
        }
        escapes.merge!((0x00..0xff).map { |c| ["\\%03o" % c, c.chr] }.to_h)
        escapes.merge!((0x01..0x1f).map do |c|
            [
                ["\\^%c" % (0x40 + c).chr, c.chr],
                ["\\M^%c" % (0x40 + c).chr, (c + 0x80).chr],
            ]
        end.flatten(1).to_h)
        escapes.merge!((0x21..0x7e).map do |c|
            ["\\M-%c" % c.chr, (c + 0x80).chr]
        end.to_h)
        s.gsub(/\\(\^[A-_?]|M[-^][!-~]|[\\#abfnrstv]|[0-7]{3}|0(?![0-7]))/n, escapes)
    end

    def self.escape(s)
        escapes = {}
        escapes.merge!((0x00..0x1f).map { |c| [c.chr, "%03o" % c] }.to_h)
        escapes.merge!((0x7f..0xff).map { |c| [c.chr, "%03o" % c] }.to_h)
        escapes.merge!({
            "\\" => "134",
            "#" => "#",
            " " => "s",
            "\n" => "n",
            "\t" => "t",
        })
        s.gsub(/[\\# \x00-\x1f\x7f-\xff]/n) { |m| "\\%s" % escapes[m] }
    end

    def self.quote(s)
        "\x27#{s}\x27"
    end

    def self.mtree_src(config, entry)
        path = escape(entry[:src])
        path = "./#{path}" unless entry[:root]
        config[:stdout].printf("%s %s\n", path, filter_args(entry[:args]).map { |k, v| "#{k}=#{v}" }.join(" "))
    end

    def self.mtree_dest(config, entry)
        path = escape(entry[:dest])
        path = "./#{path}" unless entry[:root]
        config[:stdout].printf("%s %s\n", path, filter_args(entry[:args]).map { |k, v| "#{k}=#{v}" }.join(" "))
    end

    def self.format_entries(defaults, values)
        fixed = %w[
            type uname gname mode nlink size link time cksum
            md5 md5digest
            rmd160 rmd160digest
            sha1 sha1digest
            sha256 sha256digest
            sha384 sha384digest
            sha512 sha512digest
            flags
        ]
        extra = defaults.keys + values.keys
        fixed.each { |k| extra.delete(k) }

        [*fixed, *extra].map do |k|
            val = values[k] || defaults[k]
            val ? "#{k}=#{val}" : nil
        end.compact.join(" ")
    end

    def self.format(config)
        dirname = []
        defaults = {}
        while line = config[:stdin].gets
            line.chomp!
            if line =~ /^(#|$)/
                next
            elsif line =~ /^(.*) \\$/
                line = $1 + config[:stdin].gets.chomp
                redo
            elsif line =~ %r[^/set\s+(.*)]
                defaults = $1.split(/\s+/).map { |kv| kv.split(/=/, 2) }.to_h
            elsif line =~ /^\.\.\s*$/
                dirname.pop
            elsif line =~ /^\s*(\S+)\s+(.*)/
                path = $1
                values = $2.split(/\s+/).map { |kv| kv.split(/=/, 2) }.to_h
                full_path = path[1..].include?("/")
                if values["type"] == "dir"
                    if full_path
                        dirname = path.split(%r[/])
                    else
                        dirname << path
                    end
                    config[:stdout].puts "#{File.join(*dirname)} #{format_entries(defaults, values)}"
                else
                    path = full_path ? path : File.join(*dirname, path)
                    config[:stdout].puts "#{path} #{format_entries(defaults, values)}"
                end
            end
        end
    end

    def self.install(config, entry)
        fullpath = entry[:root] ? config[:installdest] : File.join(config[:installdest], entry[:dest])
        mode = entry[:args]["mode"]&.to_i(8)
        textmode = mode ? "%04o" % mode : nil
        case entry[:args]["type"]
        when "dir"
            modearr = [mode].compact
            if config[:dry_run]
                config[:stdout].puts "Would create directory #{quote(fullpath)} with mode #{textmode}"
            else
                task = ->() do
                    Dir.mkdir(fullpath, *modearr)
                    File.chmod(mode, fullpath) if mode
                end
                begin
                    task.call()
                rescue Errno::EEXIST
                    if !File.symlink?(fullpath) && File.directory?(fullpath)
                        File.chmod(mode, fullpath) if mode
                    else
                        File.unlink(fullpath)
                        task.call()
                    end
                end
            end
        when "file"
            if config[:dry_run]
                config[:stdout].puts "Would create file #{quote(fullpath)} from #{quote(entry[:src])} with mode #{textmode}"
            else
                task = ->() do
                    if entry[:args]["contents"] == "ignore"
                        File.open(fullpath, File::CREAT|File::RDWR|File::NOFOLLOW, mode) do |dfp|
                            # Do nothing, just verify the file exists.
                        end
                    else
                        File.open(entry[:src], "rb") do |sfp|
                            File.open(fullpath, File::CREAT|File::TRUNC|File::RDWR|File::NOFOLLOW, mode) do |dfp|
                                IO.copy_stream(sfp, dfp)
                            end
                        end
                    end
                    File.chmod(mode, fullpath) if mode
                end
                begin
                    task.call()
                rescue Errno::EEXIST, Errno::ELOOP
                    !File.symlink?(fullpath) && File.directory?(fullpath) ? Dir.rmdir(fullpath) : File.unlink(fullpath)
                    task.call()
                end
            end
        when "link"
            if config[:dry_run]
                config[:stdout].puts "Would create link #{quote(fullpath)} pointing to #{quote(entry[:args]["link"])}"
            else
                task = ->() do
                    File.symlink(entry[:args]["link"], fullpath)
                end
                begin
                    task.call()
                rescue Errno::EEXIST
                    !File.symlink?(fullpath) && File.directory?(fullpath) ? Dir.rmdir(fullpath) : File.unlink(fullpath)
                    task.call()
                end
            end
        end
    end

    def self.filter_args(args)
        args.select { |k, _| /^(type|mode|link|sha[0-9]+(digest)?)$/.match(k) }
    end

    def self.main(stdin, stdout, stderr, cmdargs)
        method = cmdargs[0].to_sym.to_proc
        recurse = !cmdargs[1].nil? && !cmdargs[1].empty?
        dryrun = cmdargs.length >= 3 && !cmdargs[2].nil? && !cmdargs[2].empty?
        installdest = cmdargs.length >= 4 && cmdargs[3]
        config = { installdest: installdest, dry_run: dryrun, stdin: stdin, stdout: stdout }

        if cmdargs[0].to_sym == :format
            method.call(MTree, config)
            return 0
        elsif cmdargs[0].to_sym == :escape
            stdout.print escape(stdin.read)
            return 0
        elsif cmdargs[0].to_sym == :unescape
            stdout.print unescape(stdin.read)
            return 0
        end

        entry = { src: ".", dest: ".", args: { "type" => "dir" }, root: true }
        method.call(MTree, config, entry)

        begin
            while line = stdin.gets
                line.chomp!
                next if line =~ /^(?:#|\s*$)/
                items = line.split(" ")
                file = items.shift
                args = items.map { |item| item.split("=", 2) }.to_h
                dest = unescape(file)
                dest = dest[2..] if dest.start_with?("./")
                entry = { dest: dest, args: args }
                entry[:src] = args["src"] || entry[:dest]
                method.call(MTree, config, entry)
                if args["recurse"] == "true" && recurse
                    srcdir = entry[:src]
                    destdir = entry[:dest] || entry[:src]
                    dirmode = args["dirmode"].to_i(8)
                    plainmode, execmode = if args["filemode"] =~ /^(0[0-7]+)\+x$/
                        mode = $1.to_i(8)
                        [mode, mode | ((mode & 0444) >> 2)]
                    else
                        mode = args["filemode"].to_i(8)
                        [mode, mode]
                    end
                    entries = Dir.glob("**/*", base: srcdir).sort
                    entries.each do |path|
                        fullpath = File.join(srcdir, path)
                        destfullpath = File.join(destdir, path)
                        st = File.lstat(fullpath)
                        kind, mode, link = case
                        when st.file?
                            ["file", st.mode & 0111 != 0 ? execmode : plainmode, nil]
                        when st.directory?
                            ["dir", dirmode, nil]
                        when st.symlink?
                            ["link", 0777, File.readlink(fullpath)]
                        when st.socket? || st.chardev? || st.blockdev? || st.pipe?
                            next
                        end
                        entry = { src: fullpath, dest: destfullpath, args: { "type" => kind, "mode" => "%04o" % mode } }
                        entry[:args]["link"] = link if link
                        method.call(MTree, config, entry)
                    end
                end
            end
            0
        rescue StandardError => e
            stderr.puts "Error while processing line \x27#{line}\x27:"
            stderr.puts e.full_message
            2
        end
    end
end

exit MTree.main($stdin, $stdout, $stderr, ARGV) if __FILE__ == $0
'

do_ruby () {
    local mode="$1"
    local recurse="$2"
    local dryrun="$3"
    local dest="$4"

    ruby -Kn -e "$RUBY_SCRIPT" "$mode" "$recurse" "$dryrun" "$dest"
}

dispatch () {
    local cmd="$1"
    local recurse="$2"
    local dryrun="$3"
    local backend="$4"
    local dest="$5"

    case "$backend:$cmd" in
        sh:mtree-src)
            print_mtree src "$recurse";;
        ruby:mtree-src)
            do_ruby mtree_src "$recurse";;
        sh:mtree-dest)
            print_mtree dest "$recurse";;
        ruby:mtree-dest)
            do_ruby mtree_dest "$recurse";;
        *:validate)
            validate;;
        sh:install)
            do_install "$recurse" "$dryrun" "$dest";;
        ruby:install)
            do_ruby install "$recurse" "$dryrun" "$dest";;
        sh:escape)
            do_escape "sh";;
        perl:escape)
            do_escape "perl";;
        ruby:escape)
            do_ruby escape;;
        sh:unescape)
            do_unescape "sh";;
        perl:unescape)
            do_unescape "perl";;
        ruby:unescape)
            do_ruby unescape;;
        sh:format)
            printf 'This option is not supported in the sh backend.' >&2
            exit 2
            ;;
        ruby:format)
            do_ruby format;;
        *:dump)
            printf '%s' "$RUBY_SCRIPT"
    esac
}

main "$@"
