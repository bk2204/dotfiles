#!/bin/sh

set_sock () {
    local agent=$(ssh -G "$1" | grep identityagent | awk '{ print $2 }')
    if [ -z "$SSH_AUTH_SOCK" ] && [ -n "$agent" ]
    then
        export SSH_AUTH_SOCK="$agent"
    fi
}

HOST_OS="$(uname -s)"

if [ -n "$CODESPACE_NAME" ]
then
    set_sock localhost
    exec lawn proxy -- gh cs ssh -c "$CODESPACE_NAME" -- -A -oIdentityAgent='$SSH_AUTH_SOCK' "cd \"$CWD\" && env HOST_OS=\"$HOST_OS\" nvim $(git rev-parse --sq-quote "$@")"
fi

if [ "$REMOTE_HOST" = "$(hostname)" ] || [ "$REMOTE_HOST" = "$(hostname -f)" ]
then
    cd "$CWD"
    export HOST_OS
    exec nvim "$@"
fi

set_sock "$REMOTE_HOST"
exec lawn proxy -- ssh -A -oIdentityAgent='$SSH_AUTH_SOCK' "$REMOTE_HOST" "cd \"$CWD\" && env HOST_OS=\"$HOST_OS\" nvim $(git rev-parse --sq-quote "$@")"
