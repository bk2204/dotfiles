#!/bin/sh

HOST_OS="$(uname -s)"

if [ -n "$CODESPACE_NAME" ]
then
    exec lawn proxy -- gh cs ssh -c "$CODESPACE_NAME" -- "cd \"$CWD\" && env -u TERM HOST_OS=\"$HOST_OS\" nvim $(git rev-parse --sq-quote "$@")"
fi

if [ "$REMOTE_HOST" = "$(hostname)" ] || [ "$REMOTE_HOST" = "$(hostname -f)" ]
then
    cd "$CWD"
    export HOST_OS
    exec nvim "$@"
fi

exec lawn proxy -- ssh "$REMOTE_HOST" "cd \"$CWD\" && env -u TERM HOST_OS=\"$HOST_OS\" nvim $(git rev-parse --sq-quote "$@")"
