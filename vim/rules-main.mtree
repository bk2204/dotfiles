.config/nvim type=link link=../.vim
.vim/init.vim type=link link=../.vimrc
.vimrc type=file mode=0640 src=vim/vimrc
.vim/after type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/after
.vim/autoload type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/autoload
.vim/bundle type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/bundle
.vim/colors type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/colors
.vim/pathogen type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/pathogen
.vim/syntax type=dir mode=0750 recurse=true filemode=0640+x dirmode=0750 src=vim/syntax
