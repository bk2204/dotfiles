zsh/zshenv type=file mode=0600 dest=.config/zsh/zshenv
zsh/zshrc type=file mode=0600 dest=.config/zsh/zshrc
zsh/zlogout type=file mode=0600 dest=.config/zsh/zlogout
zsh/zprofile type=file mode=0600 dest=.config/zsh/zprofile
zsh/functions type=dir mode=0700 recurse=true filemode=0600+x dirmode=0700 dest=.config/zsh/functions
.zshenv type=link mode=0777 link=.config/zsh/zshenv
.zshrc type=link mode=0777 link=.config/zsh/zshrc
.zlogout type=link mode=0777 link=.config/zsh/zlogout
.zprofile type=link mode=0777 link=.config/zsh/zprofile
