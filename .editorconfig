[*]
charset = utf-8
insert_final_newline = true
indent_style = space
end_of_line = lf
indent_size = 4

[{*.rb,bin/{dct-{browser,clip,erb,snip,sound},errno,find-unicode,format-text,pick-color,tmux-generate-session}}]
indent_size = 2

[snippets/exec/{hash-git,kprocessconfig,randomgen,recode}]
indent_size = 2

[vim/vimrc]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[COMMIT_EDITMSG]
max_line_length = 72

[*.adoc]
max_line_length = unset
